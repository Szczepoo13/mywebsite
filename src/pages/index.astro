---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/Badge.astro";

const publications = (await getCollection("publications")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Flagship picks for the homepage teaser — full catalog lives on /projects/.
const allProjects = await getCollection("projects");
const featuredProjectSlugs = [
	"mev-agents-l2-rollups",
	"shared-liquidity-zk-rollups",
	"decentralized-sports-betting",
];
const featuredProjects = featuredProjectSlugs
	.map((slug) => allProjects.find((project) => project.id === slug))
	.filter((project) => project != null);

const stackCategories = [
	{
		label: "AI",
		items: ["llm agents", "tool calling", "rag", "mcp"],
	},
	{
		label: "Blockchain",
		items: [
			"ethereum",
			"smart contracts",
			"l1/l2",
			"foundry",
			"dex/amm",
			"zkp",
			"mev"
		],
	},
	{
		label: "Software Engineering",
		items: [
			"tdd",
			"linux",
			"sql",
			"k8s",
			"docker",
			"cloud",
			"grafana",
		],
	},
	{
		label: "Programming Languages",
		items: ["python", "typescript", "javascript", "bash", "solidity", "rust", "c++"],
	},
];

const experience = [
	{
		org: "Nextrope",
		role: "AI × Blockchain Security Engineer",
		current: true,
		description:
			"LLM-based audit automation for smart contract security: agent workflows with tool calling, retrieval and MCP integrations, EVM bytecode interpretation, and vulnerability classification.",
	},
	{
		org: "University of Zürich",
		role: "Graduate Researcher — Blockchain & Distributed Ledger Technologies Group",
		description:
			"Conducted research within the Blockchain & DLT Group as part of my MSc at the University of Zürich, under Prof. Claudio J. Tessone and Dr. Krzysztof Gogol, resulting in 2 peer-reviewed publications.",
	},
	{
		org: "Kaseya",
		role: "Software Developer",
		description:
			"Cloud team on a Business Continuity & Disaster Recovery product: backend and frontend work, unit tests, code review, and production incident investigation.",
	},
];

// TODO: replace with real Uniswap v4 hook incubator details.
const achievements = [
	{
		title: "🎓 Graduated with Honors (Magna Cum Laude)",
		description:
			"University of Zürich — M.Sc. Informatics (2026). Graduated magna cum laude for academic excellence.",
	},
	{
	title: "📄 2 Research Papers & 2 International Conference Presentations",
	description:
		"Co-authored two blockchain research papers on AI agents for MEV and ZK rollups. Presented the work at international conferences in Zürich, Switzerland (BCK24) and Mumbai, India (BCK25).",
	},
	{
		title: "🦄 Uniswap v4 Hooks Incubator",
		description:
			"Selected for the Uniswap v4 Hooks Incubator (Atrium Academy), protocol engineering cohort focused on designing, implementing, and testing production-ready Uniswap v4 Hooks. Cohort starts in October 2026.",
	},
	{
		title: "🏆 BCOLN Challenge Award — Best Distributed dApp",
		description:
			"Winner of the BCOLN Challenge Hackathon (2024) for building a decentralized sports betting platform, competing against 10 teams across Zürich.",
	},
];
---

<BaseLayout title="Szczepan Gurgul" bgPattern="grid">
	<section class="card-3d bg-surface px-6 py-8">
		<h1 class="text-2xl font-bold tracking-tight">Szczepan Gurgul</h1>
		<p class="mt-1 text-sm text-muted">AI × Blockchain Security Engineer</p>
		<p class="mt-1 text-xs font-medium tracking-wide text-muted uppercase">
			Distributed Systems • Protocol Engineering • AI Agents
		</p>
		<p class="mt-6 max-w-2xl text-sm leading-relaxed">
			Software engineer specializing in distributed systems, blockchain infrastructure, and AI agents. I
			build secure, maintainable systems and tooling - from smart contracts and DeFi primitives
		    to performance-oriented infrastructure.
		</p>
		<div class="mt-6 border-t border-border pt-4 text-sm">
			<p class="font-bold">Education</p>
			<p class="mt-1 text-muted">M.Sc. Informatics, University of Zürich — 2026</p>
			<p class="mt-1 text-muted">
				B.Sc. Mechatronic Engineering, AGH University of Science and Technology — 2023
			</p>
		</div>
		<div class="mt-6 border-t border-border pt-4 text-sm">
			<p class="font-bold">Stack</p>
			<div class="mt-3 flex flex-col gap-3">
				{
					stackCategories.map((category) => (
						<div>
							<p class="text-xs font-semibold tracking-wide text-muted uppercase">
								{category.label}
							</p>
							<div class="mt-1.5 flex flex-wrap gap-2">
								{category.items.map((item) => (
									<Badge label={item} />
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="mt-6">
		<h2 class="text-xl font-bold tracking-tight">Experience</h2>
		<div class="mt-4 border-l-2 border-border pl-6">
			{
				experience.map((job) => (
					<div class="timeline-item relative pb-6">
						<span
							class:list={[
								"timeline-dot absolute -left-[31px] top-1 h-3 w-3 rounded-full",
								job.current && "bg-accent-blue",
							]}
						/>
						<p class="text-sm">
							<span class="font-bold tracking-tight">{job.role}</span>{" "}
							<span class="font-bold text-muted">—</span>{" "}
							<span class="text-base text-muted italic">{job.org}</span>
							{job.current && (
								<span class="ml-1 text-xs font-semibold text-accent-blue">(current)</span>
							)}
						</p>
						<p class="mt-1 text-sm text-muted">{job.description}</p>
					</div>
				))
			}
			<div class="timeline-item relative">
				<span class="timeline-dot absolute -left-[31px] top-1 h-3 w-3 rounded-full" />
				<p class="text-sm">
					<span class="font-bold tracking-tight">Project Engineer Internship</span>{" "}
					<span class="font-bold text-muted">—</span>{" "}
					<span class="text-base text-muted italic">TECUMEX</span>
				</p>
				<p class="mt-1 text-sm text-muted">
					Embedded and commissioning intern work on marine radar systems in Dubai before
					moving into distributed systems.
				</p>
			</div>
		</div>
	</section>

	<section class="mt-6">
		<div class="flex items-baseline justify-between">
			<h2 class="text-xl font-bold tracking-tight">Projects</h2>
			<a
				href={`${import.meta.env.BASE_URL}projects/`}
				class="text-sm font-semibold text-accent-blue hover:underline"
			>
				All projects →
			</a>
		</div>
		<div class="mt-4 grid gap-3 sm:grid-cols-3">
			{
				featuredProjects.map((project) => (
					<a
						href={`${import.meta.env.BASE_URL}projects/${project.id}/`}
						class="card-3d bg-surface block px-5 py-4"
					>
						<h3 class="text-base font-bold tracking-tight">{project.data.title}</h3>
						<p class="mt-2 line-clamp-4 text-sm text-muted">{project.data.description}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="mt-6">
		<h2 class="text-xl font-bold tracking-tight">Selected Achievements</h2>
		<div class="mt-4 flex flex-col gap-3">
			{
				achievements.map((achievement) => (
					<div class="card-3d bg-surface px-5 py-4">
						<h3 class="text-base font-bold tracking-tight">{achievement.title}</h3>
						{achievement.description && (
							<p class="mt-2 text-sm text-muted">{achievement.description}</p>
						)}
						{achievement.highlights && (
							<ul class="mt-2 list-disc space-y-2 pl-4 text-sm text-muted">
								{achievement.highlights.map((point) => <li>{point}</li>)}
							</ul>
						)}
					</div>
				))
			}
		</div>
	</section>

	<section class="mt-6">
		<h2 class="text-xl font-bold tracking-tight">Publications</h2>
		<div class="mt-4 grid gap-2 sm:grid-cols-2">
			{
				publications.map((publication) => (
					<div class="card-3d bg-surface px-3 py-2 text-xs">
						<p class="text-base font-bold tracking-tight">
							{publication.data.url ? (
								<a
									href={publication.data.url}
									class="text-accent-blue underline"
									target="_blank"
									rel="noreferrer"
								>
									{publication.data.title}
								</a>
							) : (
								publication.data.title
							)}
						</p>
						<p class="mt-1 text-muted">
							{publication.data.venue} · {publication.data.date.getFullYear()}
						</p>
						{publication.data.description && (
							<p class="mt-2 text-muted">{publication.data.description}</p>
						)}
						{publication.data.highlights && (
							<ul class="mt-2 list-disc space-y-2 pl-4 text-muted">
								{publication.data.highlights.map((point) => <li>{point}</li>)}
							</ul>
						)}
						{publication.data.tags.length > 0 && (
							<div class="mt-2 flex flex-wrap gap-1">
								{publication.data.tags.map((tag) => (
									<Badge label={tag} />
								))}
							</div>
						)}
					</div>
				))
			}
		</div>
	</section>
</BaseLayout>
