---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/Badge.astro";
import { paperSiteName } from "../../lib/paper";
import { getProjectGroups, projectContext, type Project } from "../../lib/projects";

const base = import.meta.env.BASE_URL;

const groups = await getProjectGroups();
const ordered = groups.flatMap((group) => group.projects);
const firstSlug = ordered[0]?.id;

// The first diagram in each write-up doubles as the preview picture.
const contentImages = import.meta.glob<{ default: ImageMetadata }>(
	"../../content/projects/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);
const previewImage = (project: Project) => {
	const match = project.body?.match(/!\[([^\]]*)\]\((?:\.\/)?([^)\s]+)\)/);
	const mod = match && contentImages[`../../content/projects/${match[2]}`];
	return mod ? { src: mod.default, alt: match[1] } : undefined;
};

const kindLabel = { paper: "Research paper", competition: undefined, personal: undefined };
---

<BaseLayout title="Projects - Szczepan Gurgul" bgPattern="dots">
	<h1 class="text-2xl font-bold tracking-tight">Projects</h1>
	<p class="mt-2 max-w-[70ch] text-sm text-muted">
		Research work grouped by the paper it belongs to, then hackathons and personal projects. Open a
		project for the write-up, architecture and results.
	</p>

	<div class="mt-8 grid items-start gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
		<!-- List: groups are folders, projects are the files inside them.
		     Hover or focus previews a project, click opens it. -->
		<nav class="explorer-list card" aria-label="Projects">
			{
				groups.map((group, gi) => (
					<section class:list={["explorer-group", gi > 0 && "border-t-2 border-border"]}>
						<header class="explorer-head">
							<span class="explorer-icon" aria-hidden="true">
								{group.kind === "paper" && (
									<svg viewBox="0 0 16 16" width="16" height="16">
										<path d="M3 1.5h6.5L13 5v9.5H3z M9.5 1.5V5H13 M5.5 8h5 M5.5 10.5h5" />
									</svg>
								)}
								{group.kind === "competition" && (
									<svg viewBox="0 0 16 16" width="16" height="16">
										<path d="M4.5 2h7v4a3.5 3.5 0 0 1-7 0z M4.5 3.5H2v1.5A2.5 2.5 0 0 0 4.6 7.5 M11.5 3.5H14v1.5a2.5 2.5 0 0 1-2.6 2.5 M8 9.5v3 M5 14h6" />
									</svg>
								)}
								{group.kind === "personal" && (
									<svg viewBox="0 0 16 16" width="16" height="16">
										<path d="M1.5 3h5l1.5 2h6.5v8.5h-13z" />
									</svg>
								)}
							</span>
							<div class="min-w-0">
								{kindLabel[group.kind] && (
									<p class="text-xs font-semibold text-gold-ink">{kindLabel[group.kind]}</p>
								)}
								<h2 class="text-base font-bold tracking-tight">{group.title}</h2>
								{group.url && (
									<a
										href={group.url}
										target="_blank"
										rel="noreferrer"
										class="link-inline mt-1 inline-block text-xs font-semibold"
									>
										Read on {paperSiteName(group.url)}
									</a>
								)}
							</div>
						</header>
						<ul class="explorer-tree">
							{group.projects.map((project) => (
								<li>
									<a
										href={`${base}projects/${project.id}/`}
										class="explorer-row"
										data-project-link={project.id}
										data-active={project.id === firstSlug ? "" : undefined}
									>
										<span class="explorer-row-title">{project.data.title}</span>
										<span class="explorer-row-year">
											{project.data.award && <span class="award-chip mr-2">{project.data.award}</span>}
											{project.data.status === "in-development" ? "in progress" : project.data.date.getFullYear()}
										</span>
										<span class="explorer-row-desc">{project.data.description}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</nav>

		<!-- Preview pane (wide screens): one article per project, one visible. -->
		<div class="explorer-pane hidden lg:block">
			{
				ordered.map((project) => {
					const image = previewImage(project);
					return (
						<article
							class="explorer-preview card-3d bg-surface px-6 py-6"
							data-project={project.id}
							data-preview
							hidden={project.id !== firstSlug}
						>
							<p class="text-xs font-semibold text-gold-ink">{projectContext(project)}</p>
							<h2 class="mt-2 text-xl font-bold tracking-tight">
								{project.data.title}
								{project.data.award && <span class="award-chip ml-2 align-middle">{project.data.award}</span>}
								{project.data.status === "in-development" && (
									<span class="status-chip ml-2 align-middle">Work in progress</span>
								)}
							</h2>
							<p class="mt-3 text-sm text-muted">{project.data.description}</p>
							{image && (
								<figure class="explorer-figure mt-5">
									<Image src={image.src} alt={image.alt} width={720} loading="eager" decoding="async" />
								</figure>
							)}
							{project.data.tags.length > 0 && (
								<ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
									{project.data.tags.map((tag) => (
										<li>
											<Badge label={tag} />
										</li>
									))}
								</ul>
							)}
							<div class="mt-6 flex flex-wrap gap-3 text-sm">
								<a href={`${base}projects/${project.id}/`} class="btn-blue btn-3d px-4 py-2 font-semibold">
									Read the write-up
								</a>
								{project.data.repo && (
									<a
										href={project.data.repo}
										class="btn-ghost btn-3d px-4 py-2 font-semibold"
										target="_blank"
										rel="noreferrer"
									>
										Repo
									</a>
								)}
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</BaseLayout>

<style>
	/* Group header: a tinted band with an icon, so it reads as the folder
	   the projects below belong to. */
	.explorer-head {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1rem 1.25rem;
		background-color: var(--color-surface-alt);
		border-bottom: 2px solid var(--color-border);
	}

	.explorer-icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 28px;
		height: 28px;
		margin-top: 2px;
		border: 2px solid var(--color-ink);
		background-color: var(--color-surface);
		box-shadow: 2px 2px 0 var(--color-ink);
	}

	.explorer-icon svg {
		fill: none;
		stroke: var(--color-ink);
		stroke-width: 1.5;
		stroke-linecap: square;
		stroke-linejoin: miter;
	}

	/* Projects hang off a tree line under the header's icon. */
	.explorer-tree {
		padding: 0.5rem 0 0.75rem 2.4rem;
	}

	.explorer-tree > li {
		position: relative;
	}

	.explorer-tree > li::before,
	.explorer-tree > li::after {
		content: "";
		position: absolute;
		left: -0.9rem;
		pointer-events: none;
	}

	/* Vertical line (├ / └) and the horizontal tick into the row. */
	.explorer-tree > li::before {
		top: -0.5rem;
		bottom: 0;
		border-left: 2px solid var(--color-border);
	}

	.explorer-tree > li:last-child::before {
		bottom: auto;
		height: calc(0.5rem + 1.35rem);
	}

	.explorer-tree > li::after {
		top: 1.35rem;
		width: 0.9rem;
		border-top: 2px solid var(--color-border);
	}

	.explorer-row {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: 1rem;
		row-gap: 0.25rem;
		padding: 0.75rem 1.25rem 0.75rem 1rem;
		transition:
			background-color 0.2s var(--ease-settle),
			color 0.2s var(--ease-settle);
	}

	/* Ink marker on the left edge that grows in for the active row. */
	.explorer-row::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 4px;
		background-color: var(--color-ink);
		transform: scaleY(0);
		transition: transform 0.3s var(--ease-settle);
	}

	.explorer-row-title {
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.explorer-row-year {
		font-size: 0.75rem;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
		transition: color 0.2s var(--ease-settle);
	}

	.explorer-row-desc {
		grid-column: 1 / -1;
		font-size: 0.75rem;
		color: var(--color-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s var(--ease-settle);
	}

	.explorer-row:hover {
		background-color: var(--color-surface-alt);
	}

	.explorer-row:active {
		transform: translateY(1px);
	}

	@media (min-width: 1024px) {
		.explorer-row-desc {
			-webkit-line-clamp: 1;
		}

		.explorer-row[data-active] {
			background-color: var(--color-accent-blue);
			color: #fff;
		}

		.explorer-row[data-active]::before {
			transform: scaleY(1);
		}

		.explorer-row[data-active] .explorer-row-year,
		.explorer-row[data-active] .explorer-row-desc {
			color: rgba(255, 255, 255, 0.82);
		}

		.explorer-pane {
			position: sticky;
			top: calc(var(--frame) + var(--header-h) + 24px);
		}
	}

	.explorer-preview:not([hidden]) {
		animation: preview-in 0.32s var(--ease-settle);
	}

	@keyframes preview-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	.explorer-figure {
		height: 240px;
		border: 2px solid var(--color-ink);
		background-color: #fff;
		padding: 12px;
	}

	.explorer-figure :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
</style>

<script>
	import { showPreview } from "../../scripts/project-preview";

	document.addEventListener("astro:page-load", () => {
		const list = document.querySelector<HTMLElement>(".explorer-list");
		if (!list) return;
		const rows = [...list.querySelectorAll<HTMLAnchorElement>("[data-project-link]")];
		let timer: number | undefined;

		for (const row of rows) {
			const slug = row.dataset.projectLink!;
			// Short hover intent so sweeping the mouse across the list toward the
			// pane doesn't flip through every project on the way.
			row.addEventListener("pointerenter", (event) => {
				if (event.pointerType !== "mouse") return;
				clearTimeout(timer);
				timer = window.setTimeout(() => showPreview(document, slug), 70);
			});
			row.addEventListener("pointerleave", () => clearTimeout(timer));
			row.addEventListener("focus", () => showPreview(document, slug));
		}

		// Arrow keys move through the list like a file browser.
		list.addEventListener("keydown", (event) => {
			if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
			const index = rows.indexOf(document.activeElement as HTMLAnchorElement);
			if (index === -1) return;
			event.preventDefault();
			const next = rows[(index + (event.key === "ArrowDown" ? 1 : -1) + rows.length) % rows.length];
			next.focus();
		});
	});
</script>
