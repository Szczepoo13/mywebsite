---
interface Props {
	title: string;
	description: string;
	date: Date;
	externalUrl: string;
	platform: string;
}

const { title, description, date, externalUrl, platform } = Astro.props;
const iso = date.toISOString().slice(0, 10);
---

<details class="disclosure card-3d bg-surface px-5 py-4">
	<summary class="flex items-start gap-3 text-sm">
		<span class="disclosure-icon mt-0.5" aria-hidden="true">+</span>
		<span class="min-w-0">
			<span class="block text-base font-bold tracking-tight">{title}</span>
			<time datetime={iso} class="mt-1 block text-xs text-muted">{iso}</time>
		</span>
	</summary>
	<div class="pl-[30px]">
		<p class="mt-3 text-sm text-muted">{description}</p>
		<a
			href={externalUrl}
			class="btn-blue btn-3d mt-4 mb-1 px-3 py-1 text-xs font-semibold"
			target="_blank"
			rel="noreferrer"
		>
			Read on {platform}
		</a>
	</div>
</details>
