---
interface Props {
	slug: string;
	title: string;
	description: string;
	date: Date;
}

const { slug, title, description, date } = Astro.props;
const iso = date.toISOString().slice(0, 10);
---

<a
	href={`${import.meta.env.BASE_URL}blog/${slug}/`}
	class="card-3d card-link block bg-surface px-5 py-4"
>
	<h2 class="text-base font-bold tracking-tight">{title}</h2>
	<time datetime={iso} class="mt-1 block text-xs text-muted">{iso}</time>
	<p class="mt-2 text-sm text-muted">{description}</p>
</a>
